ninja_required_version = 1.10

rule nvcc
  command = /usr/bin/mkdir -p build && nvcc -O3 -lineinfo -I../include -MMD -MF $out.d $in -o $out $libs
  depfile = $out.d
  deps = gcc
  description = NVCC $in

build build/fp16-conversion: nvcc fp16-conversion.cu
build build/cublas-gemm-ex: nvcc cublas-gemm-ex.cu
  libs = -lcublas -lcurand -lnvToolsExt

default build/fp16-conversion build/cublas-gemm-ex
