ninja_required_version = 1.10

rule nvcc
  command = /usr/bin/mkdir -p build && nvcc -O3 -lineinfo -I../include -MMD -MF $out.d $in -o $out $libs
  depfile = $out.d
  deps = gcc
  description = NVCC $in

build build/transpose-shmem: nvcc transpose-shmem.cu
build build/transpose-shmem-timing: nvcc transpose-shmem-timing.cu
  libs = -lnvToolsExt -lcurand

default build/transpose-shmem build/transpose-shmem-timing
