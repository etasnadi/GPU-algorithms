ninja_required_version = 1.10

nvcc = nvcc
builddir = build
flags = -O3 -lineinfo -I../include

rule cuda
  command = /usr/bin/mkdir -p $builddir && $nvcc $flags -MMD -MF $out.d $in -o $out $libs
  depfile = $out.d
  deps = gcc
  description = NVCC $in

build $builddir/transpose-shmem: cuda transpose-shmem.cu

default $builddir/transpose-shmem
